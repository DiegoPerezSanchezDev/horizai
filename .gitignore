# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/artifacts/cluster-report.json
/artifacts/verifier-report.json
/artifacts/

# next.js
/.next/
/out/

# production
/build

# generated MapLibre worker artifacts
/public/maplibre/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# netlify local state
/.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts

# logs, temporary files, and local editor state
*.log
*.tmp
*.temp
*.swp
*.swo
.eslintcache
Thumbs.db
.vscode/
.idea/

# supabase CLI local link and cache state
/supabase/.temp/

# Isolated AUTH-01 Supabase test stack, local keys, inbox and session material
/.auth-01-local/

# Local assistant session state
/.claude/
