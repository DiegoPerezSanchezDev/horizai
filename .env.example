# Origen canónico público opcional si producción usa el subdominio de Netlify.
# Sin este valor, el build de producción de Netlify usa su variable URL.
# En otros alojamientos debe configurarse; en desarrollo local puede dejarse vacío.
NEXT_PUBLIC_SITE_URL=

# Estilo vectorial del mapa (OpenFreeMap dark por defecto, sin API key)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Supabase público: puede usarse en un futuro cliente browser con RLS/policies
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Editorial operator auth: server-only allowlist, comma-separated verified emails.
# Provision trusted users through Supabase Auth administration; no app self-signup.
# Keep real addresses in ignored runtime config only. Empty means deny all.
EDITORIAL_OPERATOR_EMAILS=
# Trusted app origin for auth POST Origin/CSRF checks. HTTPS required in production.
EDITORIAL_AUTH_ORIGIN=
# Optional isolated local Supabase Auth; never use privileged keys here.
# Production requires HTTPS. Defaults to the public Supabase URL/publishable key above.
EDITORIAL_AUTH_URL=
EDITORIAL_AUTH_PUBLISHABLE_KEY=

# Server-only M32 editorial reads. Leave false until the AUTH-02 activation checklist passes.
EDITORIAL_LIVE_DATA_ENABLED=false
# Persistent server-side location for immutable human-review package JSON files.
HUMAN_REVIEW_ARTIFACT_ROOT=artifacts/human-review-packages

# Supabase privilegiado: solo procesos server-side, nunca en el navegador
SUPABASE_SECRET_KEY=
# Direct PostgreSQL URL required by the guarded migration commands. Keep the value in ignored local/runtime configuration.
SUPABASE_DIRECT_DB_URL=

# Agent runtime: configure a provider endpoint explicitly before real runs.
AGENT_PROVIDER=
AGENT_API_URL=
AGENT_API_KEY=
# Historical Cerebras adapter is trial-only and permanently ineligible for free routing.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
# Cloudflare Workers AI inference only (does not move application hosting).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Required internal free-only caps; allocation must reflect remaining account capacity.
# Required free-only internal hard cap, in Neurons. Keep this at or below the account's remaining free allocation.
CLOUDFLARE_DAILY_NEURON_LIMIT=
# Optional additional request guard; leave unset unless HorizAI intentionally configures one.
CLOUDFLARE_FREE_DAILY_REQUEST_LIMIT=
# Optional model-rate overrides (current catalog defaults live centrally in free-provider-router.ts).
CLOUDFLARE_INPUT_NEURONS_PER_MILLION_TOKENS=
CLOUDFLARE_OUTPUT_NEURONS_PER_MILLION_TOKENS=
CLOUDFLARE_NEURON_SAFETY_MARGIN_BPS=
# Router stays disabled in production until 10G.3 real Cloudflare validation.
FREE_PROVIDER_ROUTER_ENABLED=
FREE_PROVIDER_SOFT_LIMIT_RATIO=
GROQ_FREE_DAILY_REQUEST_LIMIT=
GROQ_FREE_DAILY_TOKEN_LIMIT=
GROQ_FREE_MINUTE_REQUEST_LIMIT=
GROQ_FREE_MINUTE_TOKEN_LIMIT=
# Gemini (Google AI Studio free tier) adapter. Inert unless GEMINI_PROVIDER_ENABLED=true AND
# GEMINI_FREE_TIER_PROJECT_CONFIRMED=true (the key's Google Cloud project must have no billing). See docs/gemini-provider.md.
GEMINI_PROVIDER_ENABLED=
GEMINI_FREE_TIER_PROJECT_CONFIRMED=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_APPROVED_MODELS=
# Local limits (official free-tier limits are only shown in the AI Studio dashboard). Defaults: 2 RPM, 20 RPD, 6000 TPM, 40000 TPD.
GEMINI_LIMIT_RPM=
GEMINI_LIMIT_RPD=
GEMINI_LIMIT_TPM=
GEMINI_LIMIT_TPD=
GEMINI_USAGE_LEDGER_PATH=
GEMINI_PACING_MAX_WAIT_MS=
GEMINI_STRUCTURED_FORMAT=
GEMINI_THINKING_LEVEL=
GEMINI_THINKING_BUDGET=
# Deprecated Groq compatibility inputs; canonical *_HARD_CAP variables take precedence.
AGENT_MODEL_VERIFY=
AGENT_MODEL_TRANSLATE=
AGENT_MODEL_EDITOR=
AGENT_MODEL_CLASSIFY=
AGENT_MODEL_RANK=
AGENT_MODEL_CRITIC=
# Groq account limits confirmed manually for the FREE plan; RPD and TPM were also observed in response headers.
# These values are local account state, not public-document-derived guarantees. Never shared with Cloudflare.
GROQ_DAILY_REQUEST_HARD_CAP=1000
GROQ_DAILY_TOKEN_HARD_CAP=200000
GROQ_REQUESTS_PER_MINUTE_HARD_CAP=30
GROQ_TOKENS_PER_MINUTE_HARD_CAP=8000
# New-event planning only: observed complete N=1 path plus conservative margin. Stage reservations use their own estimator.
GROQ_EVENT_TOKEN_PLANNING_MARGIN_PERCENT=25
# Initial Groq event execution is sequential while RPM concurrency remains unvalidated.
GROQ_MAX_CONCURRENT_EVENTS=1
AGENT_REASONING_EFFORT_RANK=
AGENT_INCLUDE_REASONING_RANK=
AGENT_TIMEOUT_MS=
AGENT_MAX_RETRIES=
AGENT_RETRY_BACKOFF_MS=
AGENT_TEMPERATURE_VERIFY=
AGENT_REASONING_EFFORT_VERIFY=
AGENT_INCLUDE_REASONING_VERIFY=
AGENT_REASONING_EFFORT_EDITOR=
AGENT_INCLUDE_REASONING_EDITOR=
AGENT_REASONING_EFFORT_CLASSIFY=
AGENT_INCLUDE_REASONING_CLASSIFY=
AGENT_REASONING_EFFORT_TRANSLATE=
AGENT_INCLUDE_REASONING_TRANSLATE=
AGENT_REASONING_EFFORT_CRITIC=
AGENT_INCLUDE_REASONING_CRITIC=
# Deprecated Groq-only fallback: consulted only when GROQ_DAILY_REQUEST_HARD_CAP is unset; otherwise ignored.
AGENT_DAILY_REQUEST_LIMIT=20
AGENT_MAX_OUTPUT_TOKENS=
AGENT_MAX_INPUT_CHARS=
AGENT_FAIL_ON_RATE_LIMIT=
AGENT_ALLOW_PAID_FALLBACK=
AGENT_STRUCTURED_OUTPUT_MODE=
AGENT_STRUCTURED_OUTPUT_VERIFY=
AGENT_STRUCTURED_OUTPUT_TRANSLATE=
AGENT_STRUCTURED_OUTPUT_EDITOR=
AGENT_STRUCTURED_OUTPUT_CLASSIFY=
AGENT_STRUCTURED_OUTPUT_CRITIC=

# Scheduler server-only guard. Leave empty locally until a protected trigger is configured.
SCHEDULER_TRIGGER_SECRET=
SCHEDULER_TIMEZONE=Europe/Madrid
SCHEDULER_MAX_EVENTS_PER_RUN=3
SCHEDULER_LEASE_TTL_MS=3600000

# Retirada de noticias desde el panel editorial. Desactivada salvo que valga exactamente "true".
EDITORIAL_WITHDRAWAL_ENABLED=false

# Decisiones desde el panel editorial (aprobar / poner en espera / rechazar / publicar aprobadas).
# Desactivadas salvo que valgan exactamente "true" Y EDITORIAL_LIVE_DATA_ENABLED sea también "true".
# Requiere los paquetes de revisión y los checkpoints visibles para el servidor (HUMAN_REVIEW_ARTIFACT_ROOT / HUMAN_REVIEW_CHECKPOINT_ROOT).
EDITORIAL_DECISIONS_ENABLED=false
# Opcional: raíz de los checkpoints del pipeline (por defecto artifacts/pipeline-checkpoints).
HUMAN_REVIEW_CHECKPOINT_ROOT=
